{
  "schema": 12,
  "skinVariantContract": "contracts/skin-variant-contract.json",
  "shared": {
    "importPaths": [
      "vendor/mediawiki-core/resources/src/mediawiki.less",
      "vendor/wikimedia-codex/packages/codex-design-tokens/dist"
    ],
    "importAliases": {
      "mediawiki.skin.defaults.less": "vendor/mediawiki-core/resources/src/mediawiki.less/mediawiki.skin.defaults.less",
      "mediawiki.skin.default.less": "vendor/mediawiki-core/resources/src/mediawiki.less/mediawiki.skin.defaults.less",
      "mediawiki.mixins.less": "vendor/mediawiki-core/resources/src/mediawiki.less/mediawiki.mixins.less",
      "mediawiki.skin.codex/mixins/codex-public-mixins.less": "vendor/mediawiki-core/resources/src/mediawiki.less/mediawiki.skin.codex/mixins/codex-public-mixins.less",
      "@wikimedia/codex-icons/codex-icon-paths.less": "vendor/wikimedia-codex/packages/codex-icons/codex-icon-paths.less",
      "mediawiki.skin.codex-design-tokens/theme-wikimedia-ui.less": "vendor/wikimedia-codex/packages/codex-design-tokens/dist/theme-wikimedia-ui.less"
    },
    "lessPreludeEntries": [
      "vendor/wikimedia-codex/packages/codex-design-tokens/dist/theme-wikimedia-ui.less"
    ],
    "runtimeAssetDirectory": "images",
    "hostSurfaces": {
      "hostContent": "#mw-content-text[data-tt-host-content=\"1\"]",
      "hostModal": ".thetree-modal-container"
    },
    "ownershipPolicies": {
      "global": {},
      "skin": {
        "isolateHostContent": true,
        "excludedSurfaces": [
          "hostModal"
        ]
      }
    },
    "codexManifest": "vendor/mediawiki-core/resources/lib/codex/modules/manifest.json",
    "codexModuleRoot": "vendor/mediawiki-core/resources/lib/codex/modules",
    "activeMedia": [
      "all",
      "screen"
    ]
  },
  "modules": [
    {
      "name": "skins.vector.styles.legacy",
      "metadata": "vendor/mediawiki-vector-legacy/skin.json",
      "metadataRoot": "ResourceModules",
      "sourceBase": "vendor/mediawiki-vector-legacy",
      "output": "css/vendor/resource-loader/skins.vector.styles.legacy.css",
      "ownership": "skin"
    },
    {
      "name": "ext.DarkMode.styles",
      "metadata": "vendor/mediawiki-darkmode/extension.json",
      "metadataRoot": "ResourceModules",
      "sourceBase": "vendor/mediawiki-darkmode/resources",
      "output": "css/vendor/resource-loader/ext.DarkMode.styles.css",
      "ownership": "global"
    },
    {
      "name": "jquery.suggestions",
      "metadata": "vendor/mediawiki-core/resources/Resources.php",
      "metadataFormat": "php-array",
      "metadataMarker": "'jquery.suggestions' =>",
      "sourceBase": "vendor/mediawiki-core",
      "output": "css/vendor/resource-loader/jquery.suggestions.css",
      "ownership": "global"
    },
    {
      "name": "mediawiki.searchSuggest",
      "metadata": "vendor/mediawiki-core/resources/Resources.php",
      "metadataFormat": "php-array",
      "metadataMarker": "'mediawiki.searchSuggest' =>",
      "sourceBase": "vendor/mediawiki-core",
      "output": "css/vendor/resource-loader/mediawiki.searchSuggest.css",
      "ownership": "global"
    }
  ],
  "bundles": [
    {
      "name": "codex-styles",
      "sources": [
        "vendor/wikimedia-codex/packages/codex-design-tokens/dist/theme-wikimedia-ui-root.css",
        "vendor/wikimedia-codex/packages/codex/dist/codex.style.css"
      ],
      "output": "css/vendor/resource-loader/codex-styles.css"
    }
  ],
  "skinModule": {
    "source": "vendor/mediawiki-core/includes/ResourceLoader/SkinModule.php",
    "coreSourceBase": "vendor/mediawiki-core",
    "disabledFeatures": [
      "logo",
      "content-media",
      "content-links",
      "interface-category",
      "content-tables",
      "i18n-ordered-lists",
      "i18n-headings"
    ],
    "ownershipRules": [
      {
        "pattern": ".*",
        "ownership": "skin"
      }
    ],
    "configSchema": "vendor/mediawiki-core/includes/config-schema.php",
    "compatibilityMethod": "protected static function applyFeaturesCompatibility",
    "constructorMethod": "public function __construct"
  },
  "generatedRoot": "css/vendor",
  "pageStyleQueue": {
    "schema": 2,
    "profile": "vector-legacy",
    "output": "css/vendor/resource-loader/page-styles.css",
    "phases": [
      {
        "id": "host-prelude",
        "sources": [
          {
            "kind": "generated-output",
            "name": "mediawiki-variable-shim"
          }
        ]
      },
      {
        "id": "skin-output-module-styles",
        "sources": [
          {
            "kind": "skin-option-styles",
            "metadata": "vendor/mediawiki-vector-legacy/skin.json",
            "skin": "vector"
          }
        ]
      },
      {
        "id": "before-page-display-module-styles",
        "sources": [
          {
            "kind": "php-add-module-styles",
            "file": "vendor/mediawiki-darkmode/includes/Hooks.php",
            "method": "onBeforePageDisplay"
          }
        ]
      },
      {
        "id": "runtime-on-demand-module-styles",
        "sources": [
          {
            "kind": "php-module-definition",
            "file": "vendor/mediawiki-core/resources/Resources.php",
            "module": "codex-styles"
          },
          {
            "kind": "php-module-definition",
            "file": "vendor/mediawiki-core/resources/Resources.php",
            "module": "mediawiki.searchSuggest"
          }
        ]
      }
    ],
    "lifecycleAssertions": [
      {
        "kind": "php-method-call-order",
        "file": "vendor/mediawiki-core/includes/Output/OutputPage.php",
        "method": "output",
        "calls": [
          {
            "call": "loadSkinModules",
            "phase": "skin-output-module-styles"
          },
          {
            "call": "onBeforePageDisplay",
            "phase": "before-page-display-module-styles"
          },
          {
            "call": "outputPageFinal"
          }
        ]
      },
      {
        "kind": "php-method-call-order",
        "file": "vendor/mediawiki-core/includes/ResourceLoader/ClientHtml.php",
        "method": "makeLoad",
        "calls": [
          {
            "call": "sort( $modules )"
          },
          {
            "call": "$sortedModules = []"
          },
          {
            "call": "foreach ( $modules as $name )"
          }
        ]
      }
    ],
    "clientHtml": {
      "defaultSource": "local",
      "defaultGroup": ""
    },
    "batches": [
      {
        "id": "host-prelude",
        "ordering": "preserve",
        "phases": [
          "host-prelude"
        ]
      },
      {
        "id": "head-only-styles",
        "ordering": "mediawiki-clienthtml-make-load",
        "phases": [
          "skin-output-module-styles",
          "before-page-display-module-styles"
        ]
      },
      {
        "id": "runtime-on-demand",
        "ordering": "dependency-topological",
        "phases": [
          "runtime-on-demand-module-styles"
        ]
      }
    ]
  },
  "customPropertyClosure": {
    "name": "mediawiki-variable-shim",
    "output": "css/vendor/resource-loader/mediawiki-variable-shim.css",
    "localConsumerRoots": [
      "css"
    ],
    "hostProvidedPrefixes": [
      "--mw-msg-",
      "--tt-"
    ],
    "domCompositions": [],
    "localPublishedLessTokenEntrypoints": [
      "vendor/wikimedia-codex/packages/codex-design-tokens/dist/theme-wikimedia-ui.less"
    ]
  },
  "messageCatalog": {
    "output": "lib/generated/mediawiki-less-messages.json",
    "includeMessages": [
      "searchsuggest-containing"
    ],
    "languages": {
      "en": {
        "source": "vendor/mediawiki-core/languages/i18n/en.json"
      },
      "ko": {
        "source": "vendor/mediawiki-core/languages/i18n/ko.json",
        "fallback": "en"
      }
    }
  }
}
